{
  "openapi": "3.0.0",
  "info": {
    "title": "iMart SaaS API",
    "version": "1.0.0",
    "description": "Enterprise-grade multi-tenant e-commerce platform API."
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/login": {
      "post": {
        "summary": "Authenticate User",
        "tags": ["Auth"],
        "responses": {
          "200": { "description": "Token issued" }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "List Products",
        "tags": ["Public"],
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "sort", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Paginated product list" }
        }
      }
    },
    "/checkout/place-order": {
      "post": {
        "summary": "Place Order",
        "tags": ["Customer"],
        "security": [{ "sanctum": [] }],
        "responses": {
          "201": { "description": "Order created" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sanctum": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
