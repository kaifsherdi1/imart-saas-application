APP_NAME=iMart
# Use "production" and APP_DEBUG=false on any public server.
APP_ENV=local
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Public URL of the Next.js frontend (used for CORS, Stripe/Google redirects, emails)
FRONTEND_URL=http://localhost:3000
# Optional: extra comma-separated origins / regex patterns allowed by CORS,
# e.g. Vercel preview deployments: #^https://imart-.*\.vercel\.app$#
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_PATTERNS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Use "stderr" on container platforms so logs reach the platform's log viewer.
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Use "warning" or "error" in production.
LOG_LEVEL=debug

# Production: pgsql (recommended) or mysql
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=imart
# DB_USERNAME=
# DB_PASSWORD=
# Or a single connection string (overrides the above):
# DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# API token lifetime in minutes (default 7 days)
SANCTUM_EXPIRATION=10080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# A queue worker must run in production: php artisan queue:work
QUEUE_CONNECTION=database

# Production: redis recommended
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Password-reset OTPs are emailed — configure a real mailer in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Platform admin created by `php artisan db:seed` (password REQUIRED in production)
ADMIN_EMAIL=admin@imart.com
ADMIN_PASSWORD=

# Stripe (subscription payments). Webhook endpoint: {APP_URL}/api/v1/webhooks/stripe
# Subscribe the webhook to: checkout.session.completed, customer.subscription.deleted
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Google login. Redirect URL: {APP_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/api/v1/auth/google/callback

# Product image uploads
CLOUDINARY_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
