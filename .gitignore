# ========================
# Directories to exclude
# ========================
New folder/

# ========================
# Environment & Secrets
# ========================
.env
.env.*
!.env.example
*.key
auth.json

# ========================
# Laravel / PHP (imart-api)
# ========================
imart-api/vendor/
imart-api/node_modules/
imart-api/public/build/
imart-api/public/hot/
imart-api/public/storage/
imart-api/storage/*.key
imart-api/storage/pail/
imart-api/storage/logs/*.log
imart-api/bootstrap/cache/*.php
imart-api/.phpunit.result.cache
imart-api/.phpunit.cache/
imart-api/_ide_helper.php
imart-api/Homestead.json
imart-api/Homestead.yaml

# ========================
# Next.js / Node (imart-frontend)
# ========================
imart-frontend/node_modules/
imart-frontend/.next/
imart-frontend/out/
imart-frontend/build/
imart-frontend/.vercel/
imart-frontend/*.tsbuildinfo
imart-frontend/coverage/

# ========================
# OS / Editor junk
# ========================
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
.cursor/
.zed/
.nova/
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
